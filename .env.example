# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=admin
DATABASE_NAME=job_vacancy

# Kafka (локальный запуск: PLAINTEXT_HOST listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=secret_password
CLICKHOUSE_DB=vacancies

# Auth
SECRET_KEY=change_me_in_production

# OpenAI / Embeddings (опционально)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Модель для структурирования резюме (JSON) при POST /api/v1/analytics/profile/resume
OPENAI_RESUME_MODEL=gpt-4o-mini

# VK (опционально, для recommendations)
VK_ACCESS_TOKEN=
